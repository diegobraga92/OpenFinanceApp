{
  "openapi": "3.1.0",
  "info": {
    "title": "PudimFinance API",
    "description": "Personal finance application API. Immutable double-entry ledger, event sourcing, real-time reporting, receipt scanning and price tracking.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/budgets": {
      "get": {
        "tags": [
          "Budgets"
        ],
        "summary": "Lists budgets for a given month/year, joined with category display info.",
        "operationId": "list_budgets",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Year (default: current)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "query",
            "description": "Month 1-12 (default: current)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of budgets for the period",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid month parameter"
          }
        }
      },
      "post": {
        "tags": [
          "Budgets"
        ],
        "summary": "Creates or updates a budget (upsert on (category_id, month, year)).",
        "operationId": "create_budget",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBudgetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Budget updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetWithCategory"
                }
              }
            }
          },
          "201": {
            "description": "Budget created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetWithCategory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid budget payload"
          }
        }
      }
    },
    "/api/budgets/summary": {
      "get": {
        "tags": [
          "Budgets"
        ],
        "summary": "Returns budget vs actual spending for a given month/year.",
        "operationId": "budget_summary",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Year (default: current)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "query",
            "description": "Month 1-12 (default: current)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Budget vs actual summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetSummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid month parameter"
          }
        }
      }
    },
    "/api/budgets/{id}": {
      "delete": {
        "tags": [
          "Budgets"
        ],
        "summary": "Deletes a budget by ID.",
        "operationId": "delete_budget",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Budget UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Budget deleted"
          },
          "404": {
            "description": "Budget not found"
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "Lists categories, optionally filtered by type.",
        "description": "Returns `400` if an invalid `type` filter is provided.",
        "operationId": "list_categories",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter by 'income' or 'expense'",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid type filter"
          }
        }
      },
      "post": {
        "tags": [
          "Categories"
        ],
        "summary": "Creates a new category.",
        "description": "Returns `400` if the payload is invalid (missing name, invalid type,\nnon-existent parent category).",
        "operationId": "create_category",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCategoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Category created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "description": "Invalid category payload"
          }
        }
      }
    },
    "/api/reports/category-breakdown": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Category spending breakdown for a date range.",
        "operationId": "category_breakdown",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "description": "Start date (ISO). Default: first day of current month",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "End date (ISO). Default: today",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category spending breakdown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryBreakdownResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date range"
          }
        }
      }
    },
    "/api/reports/monthly": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Monthly income/expense summary over a date range.",
        "operationId": "monthly_report",
        "parameters": [
          {
            "name": "start_year",
            "in": "query",
            "description": "Start year (default: 6 months ago)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "start_month",
            "in": "query",
            "description": "Start month 1-12",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "end_year",
            "in": "query",
            "description": "End year (default: current)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "end_month",
            "in": "query",
            "description": "End month 1-12",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly income/expense summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonthlyReportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          }
        }
      }
    },
    "/api/reports/trends": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Monthly trends (income, expense, net) over the last N months.",
        "operationId": "trends",
        "parameters": [
          {
            "name": "months",
            "in": "query",
            "description": "Number of months (default 6, max 12)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly trends",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid months parameter"
          }
        }
      }
    },
    "/api/summary": {
      "get": {
        "tags": [
          "Summary"
        ],
        "summary": "Returns income, expense, and balance totals for a given month,\nwith a per-category breakdown.",
        "operationId": "get_summary",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Year to summarise (default: current)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "query",
            "description": "Month 1-12 (default: current)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid month parameter"
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Lists transactions, with optional filters (category, type, date range) and pagination.",
        "operationId": "list_transactions",
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "description": "Page size (default 50, max 200)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page offset (default 0)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "category_id",
            "in": "query",
            "description": "Filter by category UUID",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by 'income' or 'expense'",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "description": "Filter by start date (inclusive)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "Filter by end date (inclusive)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter parameters"
          }
        }
      },
      "post": {
        "tags": [
          "Transactions"
        ],
        "summary": "Creates a new transaction.",
        "operationId": "create_transaction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Transaction created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transaction"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transaction payload"
          }
        }
      }
    },
    "/api/transactions/{id}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Returns a single transaction by ID.",
        "operationId": "get_transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Transaction UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transaction"
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      },
      "put": {
        "tags": [
          "Transactions"
        ],
        "summary": "Updates an existing transaction.",
        "operationId": "update_transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Transaction UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Transaction updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transaction"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transaction payload"
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Transactions"
        ],
        "summary": "Deletes a transaction by ID.",
        "operationId": "delete_transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Transaction UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Transaction deleted"
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Returns the health status of the backend and its dependencies\n(PostgreSQL, RabbitMQ). Returns 200 if healthy, 503 if degraded.",
        "operationId": "health_handler",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service is degraded or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Exposes Prometheus-formatted metrics for scraping.\nThis endpoint is served on a separate port in production (default 3001).",
        "operationId": "metrics_handler_doc",
        "responses": {
          "200": {
            "description": "Prometheus metrics in text format",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Budget": {
        "type": "object",
        "description": "A monthly budget limit for a category.",
        "required": [
          "id",
          "category_id",
          "month",
          "year",
          "amount_limit",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "amount_limit": {
            "type": "string",
            "description": "Maximum spend limit for the month."
          },
          "category_id": {
            "type": "string",
            "format": "uuid",
            "description": "Category this budget applies to."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Row creation timestamp."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique budget identifier."
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "description": "Month (1-12)."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last row update timestamp."
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "description": "Year."
          }
        }
      },
      "BudgetListResponse": {
        "type": "object",
        "description": "Response for a paginated/period budget list.",
        "required": [
          "items",
          "month",
          "year"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BudgetWithCategory"
            },
            "description": "Budgets for the selected period."
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "description": "Month used for the query."
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "description": "Year used for the query."
          }
        }
      },
      "BudgetSummaryItem": {
        "type": "object",
        "description": "Budget vs actual spending for a single budget.",
        "required": [
          "budget",
          "actual_spent",
          "percentage",
          "remaining"
        ],
        "properties": {
          "actual_spent": {
            "type": "string",
            "description": "Actual spending for the category in the month (from transactions)."
          },
          "budget": {
            "$ref": "#/components/schemas/BudgetWithCategory",
            "description": "The budget itself (with category info)."
          },
          "percentage": {
            "type": "string",
            "description": "Percentage of the limit used (0-100+, can exceed 100)."
          },
          "remaining": {
            "type": "string",
            "description": "Remaining amount = condition. negative => over budget."
          }
        }
      },
      "BudgetSummaryResponse": {
        "type": "object",
        "description": "Response for the budget summary endpoint.",
        "required": [
          "items",
          "total_budgeted",
          "total_spent",
          "month",
          "year"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BudgetSummaryItem"
            },
            "description": "Per-budget spend vs limit."
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "description": "Month used for the query."
          },
          "total_budgeted": {
            "type": "string",
            "description": "Sum of all budget limits for the period."
          },
          "total_spent": {
            "type": "string",
            "description": "Sum of all actual spending for budgeted categories."
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "description": "Year used for the query."
          }
        }
      },
      "BudgetWithCategory": {
        "type": "object",
        "description": "Budget joined with its category display info.",
        "required": [
          "id",
          "category_id",
          "category_name",
          "month",
          "year",
          "amount_limit"
        ],
        "properties": {
          "amount_limit": {
            "type": "string",
            "description": "Maximum spend limit for the month."
          },
          "category_id": {
            "type": "string",
            "format": "uuid",
            "description": "Category id this budget applies to."
          },
          "category_name": {
            "type": "string",
            "description": "Category name."
          },
          "color": {
            "type": [
              "string",
              "null"
            ],
            "description": "Category hex color."
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "description": "Category icon identifier."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique budget identifier."
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "description": "Month (1-12)."
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "description": "Year."
          }
        }
      },
      "Category": {
        "type": "object",
        "description": "A transaction category (income or expense), optionally nested via `parent_id`.",
        "required": [
          "id",
          "name",
          "type",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ],
            "description": "Hex color code (e.g., `#ef4444`)."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Row creation timestamp."
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "description": "Icon identifier used by the web/mobile UIs."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique category identifier."
          },
          "name": {
            "type": "string",
            "description": "Display name (e.g., \"Food & Groceries\")."
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Optional parent category for subcategories."
          },
          "type": {
            "type": "string",
            "description": "`income` or `expense`."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last row update timestamp."
          }
        }
      },
      "CategoryBreakdownItem": {
        "type": "object",
        "description": "A single category's aggregated totals for the category-breakdown report.",
        "required": [
          "total",
          "percentage",
          "transaction_count"
        ],
        "properties": {
          "category_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Category UUID (null when uncategorised)."
          },
          "category_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Category name."
          },
          "color": {
            "type": [
              "string",
              "null"
            ],
            "description": "Hex color."
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "description": "Icon identifier."
          },
          "percentage": {
            "type": "string",
            "description": "Percentage of all expenses for the period."
          },
          "total": {
            "type": "string",
            "description": "Total amount for the category."
          },
          "transaction_count": {
            "type": "integer",
            "format": "int64",
            "description": "Number of transactions in this category."
          }
        }
      },
      "CategoryBreakdownResponse": {
        "type": "object",
        "description": "Response for the category-breakdown report.",
        "required": [
          "categories",
          "start_date",
          "end_date"
