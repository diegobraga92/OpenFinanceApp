            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "query",
            "description": "Month 1-12 (default: current)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
