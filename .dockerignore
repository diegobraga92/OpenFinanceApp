# Keep the repo-root build context small. The web service builds with
# `context: .` (see docker-compose.yml), so everything here would otherwise
# be uploaded to the Docker daemon on every build.

# VCS
.git
.github
.gitignore

# Rust build artifacts (backend/target alone is ~14 GB)
backend/target/
**/target/

# Node
**/node_modules/
**/dist/
**/.expo/
mobile/android/
mobile/ios/
**/*.tsbuildinfo

# Local environment files — never ship secrets into an image
.env
.env.*
!.env.example
!.env.docker
