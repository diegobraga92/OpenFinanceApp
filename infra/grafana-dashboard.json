    {
      "title": "RabbitMQ Connected",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "pudim_rabbitmq_connected",
          "legendFormat": "rabbitmq",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "thresholds": [
              { "color": "#f2495c", "value": null },
              { "color": "#73bf69", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Connected",
                  "color": "green"
                },
                "0": {
                  "text": "Disconnected",
                  "color": "red"
                }
              }
            }
          ]
        }
      }
    },
