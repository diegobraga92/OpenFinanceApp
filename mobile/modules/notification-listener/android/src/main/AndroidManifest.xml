<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Required so the system binds our NotificationListenerService. -->
  <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />

  <application>
    <!--
      Declared with the BIND_NOTIFICATION_LISTENER_SERVICE permission + intent
      filter, which is what makes this app appear in
      Settings → Special app access → Notification access.
      The user must explicitly enable it there.
    -->
    <service
      android:name="expo.modules.notificationlistener.NotificationListenerService"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
